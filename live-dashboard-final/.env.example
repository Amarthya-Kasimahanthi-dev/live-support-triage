# Copy this file to .env and fill in the two REQUIRED values. Never commit .env.

# REQUIRED: your published Google Sheet CSV link (File > Share > Publish to web > CSV)
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_ID/pub?output=csv

# REQUIRED: your Anthropic API key (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Used only outside Docker. Docker overrides it to point at the db container.
DATABASE_URL=postgresql://dashboard:dashboard_dev_password@localhost:5432/dashboard

POLL_SECONDS=15
